# Copy to .env values into your shell or hosting dashboard. Never commit real secrets.
PORT=8080
# Long random string used to sign login tokens. REQUIRED in production.
ORBIT_SECRET=change-me-to-a-long-random-string
# Where the JSON database is stored.
ORBIT_DATA=./data/db.json
# OPTIONAL cloud guide. The built-in ORBIT Brain needs none of this. Set ORBIT_CLOUD_AI=1 and a key to use a hosted model instead.
ORBIT_CLOUD_AI=0
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Token for approving community-submitted spots (POST /api/admin/submissions/:id).
ORBIT_ADMIN_TOKEN=
# Development only: return the one-time verification code in the signup response.
ORBIT_DEV_OTP=1
